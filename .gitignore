# Python bytecode cache (auto-generated, not source)
__pycache__/
*.pyc
*.pyo
# --- Claude Code / editor local state (per-machine, do NOT commit) ---
# Exception: the branch guard hook and the settings block that wires it up ARE committed,
# so Claude Code sessions on the web get the same guard as local ones.
.claude/*
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/branch_guard.py
!.claude/settings.json
.claude-*
*.local

# --- OS / editor cruft ---
Thumbs.db
Desktop.ini
.DS_Store
.vscode/

# --- Accidental junk from shell mishaps ---
# (files created by stray redirects, pager fragments, etc.)
h origin*
t --oneline*

# Playwright for test_review_digest.mjs (not a repo dependency; installed ad hoc).
# `npm install playwright` writes the manifests too, and they describe that ad-hoc
# install rather than anything this repo depends on — everything else here is Python.
node_modules/
package.json
package-lock.json
