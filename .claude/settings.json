{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/branch_guard.py\"; [ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || [ ! -f \"$f\" ] || python3 \"$f\""
          }
        ]
      }
    ]
  }
}
